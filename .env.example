# ========================================================
# EthnoKG Environment Configuration Reference
# ========================================================

# Application Settings
APP_NAME=EthnoKG
ENVIRONMENT=production
SECRET_KEY=generate-a-strong-random-32-byte-secret-key-here

# Server Settings (Automatically provided by Render at runtime)
PORT=8000

# Frontend URL & CORS
FRONTEND_URL=https://ethnokg-frontend.onrender.com
CORS_ORIGINS=["https://ethnokg-frontend.onrender.com","http://localhost:5173","http://localhost:3000"]

# Database Configuration
# Local development:
# DATABASE_URL=sqlite:///./ethno_kg.db
# Render PostgreSQL (Automatically provided by Render from Database Connection String):
# DATABASE_URL=postgresql://ethnokg_user:password@dpg-xxxxx.render.com/ethnokg_db
DATABASE_URL=

# AI & LLM Services (Optional: EthnoKG includes a 100% offline local extraction engine by default)
GEMINI_API_KEY=
OPENAI_API_KEY=
USE_LLM_EXTRACTION=false

# Curation & Verification Settings
REQUIRE_CURATOR_APPROVAL=true
DEFAULT_CONFIDENCE_THRESHOLD=0.75
